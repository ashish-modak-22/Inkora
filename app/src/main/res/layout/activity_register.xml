<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_base"
    android:fillViewport="true"
    tools:context=".ui.register.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Decorative floating glass blobs, same language as Login -->
        <View
            android:id="@+id/glassBlobOne"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="-50dp"
            android:layout_marginEnd="-60dp"
            android:alpha="0.5"
            android:background="@drawable/bg_glass_blob"
            android:backgroundTint="@color/glass_blob_2"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/glassBlobTwo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="-60dp"
            android:alpha="0.45"
            android:background="@drawable/bg_glass_blob"
            android:backgroundTint="@color/glass_blob_1"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/glassBlobThree"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="300dp"
            android:layout_marginEnd="-30dp"
            android:alpha="0.35"
            android:background="@drawable/bg_glass_blob"
            android:backgroundTint="@color/glass_blob_3"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerContentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
<!--            android:layoutAnimation="@anim/layout_anim_header"-->

            <View
                android:id="@+id/logoBackdrop"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.9"
                android:background="@drawable/bg_glass_blob"
                android:backgroundTint="#FFFFFF"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- App Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notes"
                app:tint="@color/primary"
                app:layout_constraintBottom_toBottomOf="@id/logoBackdrop"
                app:layout_constraintEnd_toEndOf="@id/logoBackdrop"
                app:layout_constraintStart_toStartOf="@id/logoBackdrop"
                app:layout_constraintTop_toTopOf="@id/logoBackdrop" />

            <!-- App Name -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="Notes App"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logoBackdrop" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Solid register card, color-matched to the glass background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/registerFormCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/card_register_solid"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContentContainer">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/registerFormFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="26dp">
<!--                android:layoutAnimation="@anim/layout_anim_form_fields"-->

                <!-- Heading -->
                <TextView
                    android:id="@+id/tvHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="@color/on_register_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Create your account to get started"
                    android:textColor="@color/on_register_secondary"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeading" />

                <!-- Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:hint="Full Name"
                    android:textColorHint="@color/on_register_hint"
                    app:boxBackgroundColor="@color/card_register_light"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/primary_light"
                    app:errorEnabled="true"
                    app:hintTextColor="@color/primary_light"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/primary_light"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_register_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Email"
                    android:textColorHint="@color/on_register_hint"
                    app:boxBackgroundColor="@color/card_register_light"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/primary_light"
                    app:errorEnabled="true"
                    app:hintTextColor="@color/primary_light"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/primary_light"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nameLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/on_register_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Password"
                    android:textColorHint="@color/on_register_hint"
                    app:boxBackgroundColor="@color/card_register_light"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/primary_light"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/on_register_hint"
                    app:errorEnabled="true"
                    app:hintTextColor="@color/primary_light"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/primary_light"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/emailLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/on_register_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Register Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/primary_light"
                    android:text="Register"
                    android:textAllCaps="false"
                    android:textColor="@color/card_register_solid"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:elevation="4dp"
                    app:rippleColor="@color/primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/passwordLayout" />

                <!-- Loading indicator over the button -->
                <ProgressBar
                    android:id="@+id/registerProgressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/card_register_solid"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/registerButton"
                    app:layout_constraintEnd_toEndOf="@id/registerButton"
                    app:layout_constraintStart_toStartOf="@id/registerButton"
                    app:layout_constraintTop_toTopOf="@id/registerButton" />

                <!-- Divider -->
                <View
                    android:id="@+id/registerDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#3D5B4FAE"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/registerButton" />

                <!-- Login -->
                <TextView
                    android:id="@+id/loginTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Already have an account? Login"
                    android:textColor="@color/primary_light"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/registerDivider" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>